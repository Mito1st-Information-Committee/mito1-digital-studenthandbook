rules_version = '2';

/**
 * Firestore Security Rules for mito1-digital-studenthandbook
 *
 * IMPORTANT: These rules must be deployed to Firebase Console.
 *   1. Go to Firebase Console > Firestore Database > Rules
 *   2. Paste the contents of this file
 *   3. Click "Publish"
 *
 * Alternatively, install firebase-tools and run:
 *   firebase deploy --only firestore:rules
 *
 * =====================================================================
 * ロール定義（Issue #18: ロールの細分化 — src/roles.js と対応）
 * =====================================================================
 *   student        生徒（未承認/承認済みは users.approved で区別）
 *   teacher        先生（公欠申請の顧問・担任として承認を行う）
 *   moderator      モデレーター（生徒）— 委員会内の委員
 *   admin_student  管理者（生徒）— 委員会内の管理者
 *   admin_teacher  管理者（先生）— 委員の顧問先生
 *   owner          オーナー — 全て可能
 *
 * 権限マトリクス:
 *   モデレーター   : 公欠申請ケース閲覧不可 / ロール変更不可 / 生徒の承認切替は可能 /
 *                    ユーザー情報閲覧可・変更不可 / 条文変更可 / 問い合わせ閲覧可・返信不可
 *   管理者(生徒)   : 公欠申請ケース閲覧不可 / ロール変更は自分以下まで可 / 生徒承認可 /
 *                    ユーザー情報変更可 / 条文変更可 / 問い合わせ返信可
 *   管理者(先生)   : 公欠申請ケース閲覧可能。他は管理者(生徒)と同じ
 *   オーナー       : 全て可能
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // Helper functions — 基本
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerUid(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isRole(r) {
      return hasProfile() && myRole() == r;
    }

    // 承認済み生徒本人か（公欠申請フォームの先生メールサジェスト機能などで使用）
    function isApprovedStudentSelf() {
      return hasProfile()
        && myRole() == 'student'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // =============================================
    // Helper functions — ロール判定
    // =============================================
    function isOwnerRole()      { return isRole('owner'); }
    function isAdminTeacher()   { return isRole('admin_teacher'); }
    function isAdminStudent()   { return isRole('admin_student'); }
    function isModerator()      { return isRole('moderator'); }
    function isTeacherRole()    { return isRole('teacher'); }

    // 委員会の管理者以上（ロール変更・ユーザー情報変更・問い合わせ返信が可能）
    function isCommitteeAdmin() {
      return isAdminStudent() || isAdminTeacher() || isOwnerRole();
    }

    // 委員会スタッフ（モデレーター以上。管理パネルへのアクセス・条文編集・問い合わせ閲覧が可能）
    function isStaff() {
      return isModerator() || isCommitteeAdmin();
    }

    // 公欠申請ケースの閲覧・操作が可能なロール（管理者(先生)・オーナー・顧問/担任の先生自身）
    function canTouchCases() {
      return isTeacherRole() || isAdminTeacher() || isOwnerRole();
    }

    // ロールの階層レベル（自分より上位のロールは操作できない）
    function roleLevel(r) {
      return r == 'owner' ? 99
        : (r == 'admin_teacher' || r == 'admin_student') ? 2
        : r == 'moderator' ? 1
        : 0;
    }

    // 指定フィールドのみが変更されたか
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 本人が自分のドキュメントに書き込んでよいフィールド
    // （LINE連携・Google連携・お知らせ既読・通知受け取り設定・氏名等の自己更新用。
    //  role / approved / betaTester は権限昇格に直結するため本人更新不可）
    // email / previousEmails / authProvider / photoURL / googleLinkedAt は
    // Google連携時の正規メアド同期用（連携のみ・新規登録不可の方針）
    // notificationPrefs / pushEnabled は「受け取る通知」の選択・Push利用状態（Issue #21）
    function selfUpdatableKeys() {
      return ['name', 'grade', 'class', 'number',
              'email', 'previousEmails', 'authProvider', 'photoURL', 'googleLinkedAt',
              'lineUserId', 'lineDisplayName', 'linePictureUrl', 'lineNotify', 'lineLinkedAt',
              'lastSeenAnnouncementsAt',
              'notificationPrefs', 'pushEnabled'];
    }

    // =============================================
    // Users collection
    // =============================================
    match /users/{userId} {
      // 閲覧（get: 単一ドキュメント取得）: 本人 or 委員会スタッフ（モデレーター以上） or 先生（teacher）
      allow get: if isOwnerUid(userId) || isStaff() || isTeacherRole();

      // 閲覧（list: 一覧取得）:
      //  - 本人 or 委員会スタッフ（モデレーター以上）: 全件
      //  - 承認済み生徒: 先生（role=='teacher'）のドキュメントのみ
      //    （公欠申請フォームの顧問・担任メールアドレスサジェスト機能用。
      //     クライアント側は where('role','==','teacher') のクエリを必ず使用すること）
      allow list: if isOwnerUid(userId) || isStaff()
        || (isApprovedStudentSelf() && resource.data.role == 'teacher');

      // 作成: 本人の登録時のみ
      // （role は student/teacher のみ。approved / betaTester 付きでの登録は不可 — Issue #53）
      // 生徒は学年・クラス・出席番号が必須（空欄→0での登録を防ぐ）
      allow create: if isOwnerUid(userId)
        && request.resource.data.role in ['student', 'teacher']
        && (!('approved' in request.resource.data) || request.resource.data.approved == false)
        && (!('betaTester' in request.resource.data) || request.resource.data.betaTester == false)
        && (
          request.resource.data.role != 'student'
          || (
            request.resource.data.grade is number
            && request.resource.data['class'] is number
            && request.resource.data.number is number
            && request.resource.data.grade >= 1 && request.resource.data.grade <= 3
            && request.resource.data['class'] >= 1 && request.resource.data['class'] <= 6
            && request.resource.data.number >= 1 && request.resource.data.number <= 50
          )
        );

      // 更新:
      //  1. 本人による自分の情報更新（LINE連携・既読管理等の安全なフィールドのみ。
      //     role / approved / betaTester の自己変更は不可 — Issue #53）
      //  2. モデレーター: 生徒の承認状態（approved）のみ切替可能。ロール変更・その他情報変更は不可
      //  3. 委員会管理者(admin_student/admin_teacher)・オーナー: 自分のロールレベル以下の
      //     ユーザーに対してのみ、情報変更・ロール変更が可能（betaTester の付与を含む。
      //     自分より上位ロールへの変更や、自分より上位ロールのユーザーの変更は不可）
      allow update: if (isOwnerUid(userId) && onlyChanged(selfUpdatableKeys()))
        || (isModerator() && resource.data.role == 'student' && onlyChanged(['approved']))
        || (
             isCommitteeAdmin()
             // 更新前・更新後どちらのロールも自分のレベル以下であること
             // （自分より上位のユーザーを操作できない／自分より上位のロールへ変更できない）
             && roleLevel(resource.data.role) <= roleLevel(myRole())
             && roleLevel(request.resource.data.role) <= roleLevel(myRole())
           );

      // 削除: 委員会管理者以上で、自分のロールレベル以下の対象のみ
      allow delete: if isCommitteeAdmin() && roleLevel(resource.data.role) <= roleLevel(myRole());
    }

    // =============================================
    // Push subscriptions (Web Push / PWA通知)
    // users/{userId}/pushSubscriptions/{subId}
    //  - 書き込み: 本人のみ（購読ON/OFFは本人の操作）
    //  - 読み取り: 本人 or 先生・委員会スタッフ
    //    （承認完了通知の送信時に先生側クライアントが購読情報を読むため。
    //     Workersは秘密鍵のみ保持しFirestoreを読まない設計）
    // =============================================
    match /users/{userId}/pushSubscriptions/{subId} {
      allow read: if isOwnerUid(userId) || isStaff() || isTeacherRole();
      allow create, update: if isOwnerUid(userId);
      allow delete: if isOwnerUid(userId);
    }

    // 管理画面で「Push利用状況」を確認するための collectionGroup クエリ用ルール（Issue #21）
    // 一覧は先生・委員会スタッフのみ読み取り可（個別パスの上記ルールと同等の権限）。
    // 対象のユーザーに紐づく pushSubscriptions ドキュメントのみがマッチする。
    match /{path=**}/pushSubscriptions/{subId} {
      allow read: if isStaff() || isTeacherRole();
    }

    // =============================================
    // LINE連携セッション（PWA/別タブ分断の解消用）
    //   doc id = state（192bitランダム。本人のみ知る秘密キー＝capability）
    //   OAuthの「同じタブ・同じログイン状態に戻ってくる」前提を捨て、
    //   このセッションdocを中継して「認可側（コールバック）」と
    //   「連携確定側（元のタブ/PWA）」を分離する。
    //
    //   - create : 本人のみ（uid一致・status=pending）
    //   - read   : 本人のみ（uid一致。ポーリングは本人が行う）
    //   - update :
    //       コールバック側（未ログイン・別コンテキストでも可・capability方式）:
    //         status pending|done → done（uid不変・プロフィールのみ書き込み）
    //       本人側:
    //         status done → consumed（連携確定後・一度だけ） /
    //         status pending → cancelled（中断）
    //   - delete : 本人のみ（古いセッションの掃除用）
    // =============================================
    match /lineLinkSessions/{state} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      allow update: if (
            resource.data.status in ['pending', 'done']
            && request.resource.data.status == 'done'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'lineUserId', 'displayName', 'pictureUrl', 'completedAt'])
          )
        || (isAuthenticated()
            && resource.data.uid == request.auth.uid
            && (
                 (resource.data.status == 'done' && request.resource.data.status == 'consumed')
              || (resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =============================================
    // Cases (absence applications) collection
    // 公欠申請ケース: モデレーター・管理者(生徒)は閲覧不可
    // =============================================
    match /cases/{caseId} {
      // Helper: check if the update request provides a valid token
      // (used for unauthenticated email one-click approval/rejection)
      function hasValidToken() {
        return 'providedToken' in request.resource.data
          && request.resource.data.providedToken is string
          && request.resource.data.providedToken.size() > 0
          && (
               request.resource.data.providedToken == resource.data.approveToken
            || request.resource.data.providedToken == resource.data.rejectToken
            || request.resource.data.providedToken == resource.data.homeRoomApproveToken
            || request.resource.data.providedToken == resource.data.homeRoomRejectToken
          );
      }

      // 個別ドキュメント取得（get）はトークン照合用に誰でも可
      // 一覧取得（list）は次のいずれか:
      //  - 先生（顧問/担任本人）・管理者(先生)・オーナー（管理パネル/先生ダッシュボード全件）
      //  - 申請した生徒本人（マイページの申請履歴）
      //  - 自分が顧問/担任として指定されているケース（メールアドレス一致）
      // モデレーター・管理者(生徒)には一覧権限を与えない（Issue #18: 公欠申請ケース閲覧不可）
      allow get: if true;
      allow list: if canTouchCases()
        || (isAuthenticated() && resource.data.studentId == request.auth.uid)
        || (isAuthenticated() && request.auth.token.email != null
            && (resource.data.supervisorEmail == request.auth.token.email
                || resource.data.homeRoomEmail == request.auth.token.email));

      // 作成: 生徒本人の申請作成
      allow create: if isAuthenticated();

      // 更新: 先生（顧問/担任本人）・管理者(先生)・オーナー、またはメールリンクの有効トークン
      allow update: if canTouchCases() || hasValidToken();

      // 削除: 申請した生徒本人（取り下げ）、または先生・管理者(先生)・オーナー
      allow delete: if isAuthenticated()
        && (resource.data.studentId == request.auth.uid || canTouchCases());
    }

    // =============================================
    // Content collections (public read, staff-only write)
    // These are the handbook content collections
    // 条文などのコンテンツ変更は委員会スタッフ（モデレーター以上）が可能
    // =============================================
    match /content/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Read-only collections for all users (handbook data)
    match /{collection}/{docId} {
      allow read: if collection in [
        'history', 'principals', 'songs', 'rules', 'special',
        'events', 'curriculum', 'council-charter', 'council-rules'
      ];
      // Write requires committee staff (admin panel)
      allow write: if isStaff() && collection in [
        'history', 'principals', 'songs', 'rules', 'special',
        'events', 'curriculum', 'council-charter', 'council-rules'
      ];
    }

    // =============================================
    // Contacts / Inquiries collection
    // モデレーターは閲覧のみ（下書きはクライアント内のみで保存不要）。
    // 返信の保存・送信・状態変更・削除は委員会管理者以上のみ。
    // =============================================
    match /contacts/{contactId} {
      allow read: if isStaff();
      allow create: if true;  // Anyone can submit a contact form
      allow update: if isCommitteeAdmin();
      allow delete: if isCommitteeAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isStaff();
      allow create: if true;  // Anyone can submit
      allow update: if isCommitteeAdmin();
      allow delete: if isCommitteeAdmin();
    }

    // =============================================
    // Timetable API keys — 時間割APIのKey管理 (外部提供・有料前提)
    //  - read/write: 委員会管理者以上のみ（モデレーター不可）。
    //    keyHash（秘密鍵のSHA-256）は平文キーと同等の機密ではないが、
    //    発行・無効化・quota変更は課金に直結するため管理者に限定する。
    //  - Workers はサービスアカウント（管理者権限・ルール適用外）で読むため、
    //    クライアントからの直接読み取りは不要。API利用者は ?key= で画像のみ取得する。
    // フィールド:
    //  keyId, keyHash(sha256hex), keyPrefix(表示用), name, quotaDaily,
    //  revoked, revokedAt, dailyDate(YYYY-MM-DD JST), dailyCount, totalCount,
    //  lastUsedAt, createdAt, createdBy, note
    // =============================================
    match /timetableApiKeys/{keyId} {
      allow read: if isCommitteeAdmin();
      allow create: if isCommitteeAdmin();
      allow update: if isCommitteeAdmin();
      allow delete: if isCommitteeAdmin();
    }

    // =============================================
    // Feature flags — βテスト管理 (Issue #53)
    //  - read: 全員可（未ログインでも判定できるよう公開。
    //    フラグ自体に機密情報は持たせないこと）
    //  - write: 委員会スタッフ（モデレーター以上）のみ
    // フィールド:
    //  key, name, description, status(disabled/beta/enabled),
    //  createdAt, updatedAt, createdBy
    // =============================================
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // =============================================
    // Announcements (Issue #37: アプリ内お知らせ)
    //  - read: 全員可（未ログインでも一覧は閲覧可。
    //    登録日以前の除外・未読判定はクライアント側で行う）
    //  - write: 委員会スタッフ（モデレーター以上）のみ
    //    （Push通知連携はしない。既読管理は users.lastSeenAnnouncementsAt
    //     + クライアントの localStorage で行うためサーバー側は不要）
    // フィールド:
    //  title, body, category(info/update/feature/important/welcome),
    //  linkPage(任意), status(published/draft), pinned(bool),
    //  publishedAt, createdAt, updatedAt, createdBy
    // =============================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
